{
  "name": "youth-inn-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shanghai Youth Inn search and verified email alerts on Cloudflare Workers and D1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "dev": "node --env-file-if-exists=.env.local --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "preview:cloud": "wrangler dev",
    "deploy": "node --env-file-if-exists=.env.local scripts/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
