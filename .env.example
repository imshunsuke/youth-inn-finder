# Local development; copy to .env.local. Never commit real secrets.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
ENABLE_MONITORING=true
# Optional locally. APP_SECRET is generated in private .data/ when omitted.
# APP_SECRET=at-least-32-random-bytes
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=your-verified-sender@example.com
MAIL_DAILY_LIMIT=250
MAIL_NOTIFICATION_DAILY_LIMIT=8
